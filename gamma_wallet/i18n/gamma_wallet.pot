"    <div style=\"text-align:center;margin:20px 0\">\n"
"        <img t-att-src=\"object.gamma_qr_url\" width=\"200\" height=\"200\" alt=\"Reward QR code\" style=\"display:block;margin:0 auto 14px\"/>\n"
"        <a t-att-href=\"object.gamma_link\" style=\"color:#2e9bcc;font-weight:bold;font-size:15px\">On your phone? Open in Gamma Wallet</a>\n"
"    </div>\n"
"    <p style=\"margin:0;font-size:13px;color:#5b6b76\">The reward is then added to your wallet, under <t t-out=\"object.company_id.name or ''\">our shop</t>.</p>\n"
"</div>\n"
"        "
