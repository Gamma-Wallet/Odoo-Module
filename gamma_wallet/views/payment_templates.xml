<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No "Secured by …" line under the option: Gamma is not a card processor. -->
    <template id="token_form" inherit_id="payment.token_form">
        <xpath expr="//t[@t-set='hide_secured_by']" position="attributes">
            <attribute name="t-value" separator=" " add="or provider_sudo.code == 'gamma_wallet'"/>
        </xpath>
    </template>
    <template id="payment_method_form" inherit_id="payment.method_form">
        <xpath expr="//t[@t-set='hide_secured_by']" position="attributes">
            <attribute name="t-value" separator=" " add="or provider_sudo.code == 'gamma_wallet'"/>
        </xpath>
    </template>
    <!-- The checkout posts the transaction reference here; the module then asks Gamma for a QR code. -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>
</odoo>
